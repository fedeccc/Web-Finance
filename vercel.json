{
    "version": 2,
    "framework": "laravel",
    "commands": {
        "build": "php artisan config:cache && php artisan route:cache"
    },
    "builds": [
        {
            "src": "public/index.php",
            "use": "@vercel/php"
        }
    ],
    "routes": [
        {
            "src": "/(css|js|images)/(.*)",
            "dest": "public/$1/$2"
        },
        {
            "src": "/(.*)",
            "dest": "public/index.php"
        }
    ]
}